{
	"schemaVersion": 1,
	"id": "gemini",
	"version": "${version}",
	"name": "Gemini",
	"description": "Shared registration, event, and component APIs for Gemini-based mods.",
	"authors": [
		"FromtheArakiel"
	],
	"license": "ARR",
	"icon": "assets/gemini/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.arakiel.gemini.Gemini",
			"dev.arakiel.gemini.component.internal.base.ComponentsInternals::init",
			"dev.arakiel.gemini.component.internal.block.GeminiBlockComponents::init",
			"dev.arakiel.gemini.component.internal.chunk.GeminiChunkComponents::init",
			"dev.arakiel.gemini.component.internal.entity.GeminiEntityComponents::init",
			"dev.arakiel.gemini.component.internal.level.GeminiLevelComponents::init",
			"dev.arakiel.gemini.component.internal.scoreboard.GeminiScoreboardComponents::init",
			"dev.arakiel.gemini.component.internal.world.GeminiWorldComponents::init"
		],
		"gemini:static-components": [
			"dev.arakiel.gemini.component.internal.token.ConditionalTokenRegistration"
		],
		"gemini:components": [
			"dev.arakiel.gemini.component.internal.token.ConditionalTokenRegistration"
		],
		"client": [
			"dev.arakiel.gemini.client.GeminiClient",
			"dev.arakiel.gemini.component.internal.block.GeminiBlockClient::initClient",
			"dev.arakiel.gemini.component.internal.chunk.GeminiChunkClient::initClient",
			"dev.arakiel.gemini.component.internal.entity.GeminiEntityClient::initClient",
			"dev.arakiel.gemini.component.internal.level.GeminiLevelClient::initClient",
			"dev.arakiel.gemini.component.internal.scoreboard.GeminiScoreboardClient::initClient",
			"dev.arakiel.gemini.component.internal.world.GeminiWorldClient::initClient"
		],
		"modmenu": [
			"dev.arakiel.gemini.client.GeminiModMenu::create"
		]
	},
	"mixins": [
		"gemini.mixins.json",
		{
			"config": "gemini.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "gemini.accesswidener",
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_1297": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_2586": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_2791": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_5217": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_269": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_268": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			],
			"net/minecraft/class_1937": [
				"dev/arakiel/gemini/component/api/ComponentAccess"
			]
		}
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
